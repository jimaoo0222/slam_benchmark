diff -ruN '--exclude=.git' '--exclude=Log' '--exclude=build' '--exclude=install' a/include/ros2_compat.h b/include/ros2_compat.h
--- a/include/ros2_compat.h	1970-01-01 08:00:00.000000000 +0800
+++ b/include/ros2_compat.h	2026-10-25 18:00:32.120186419 +0800
@@ -0,0 +1,46 @@
+#ifndef POINT_LIO_ROS2_COMPAT_H
+#define POINT_LIO_ROS2_COMPAT_H
+
+// ── ROS 1 → ROS 2 兼容层 ──
+// 上游 Point-LIO 是 ROS 1 代码，本移植只在这里做最小适配，
+// 算法核心（Estimator / IESKF / preprocess 数值部分）保持原样。
+
+#include <rclcpp/rclcpp.hpp>
+#include <builtin_interfaces/msg/time.hpp>
+
+// ROS 1 的 header.stamp.toSec() 替代
+inline double stamp2sec(const builtin_interfaces::msg::Time &t)
+{
+    return static_cast<double>(t.sec) + static_cast<double>(t.nanosec) * 1e-9;
+}
+inline double stamp2sec(const rclcpp::Time &t) { return t.seconds(); }
+
+// ROS 1 的 ros::Time().fromSec(x) 替代
+inline rclcpp::Time to_rcl_time(double t_sec)
+{
+    return rclcpp::Time(static_cast<int64_t>(t_sec * 1e9));
+}
+
+// ROS 1 的 ROS_INFO / ROS_WARN 宏（printf 风格，签名少一个 logger 参数）
+namespace point_lio_compat {
+inline rclcpp::Logger &logger()
+{
+    static rclcpp::Logger lg = rclcpp::get_logger("point_lio");
+    return lg;
+}
+}  // namespace point_lio_compat
+
+#ifndef ROS_INFO
+#define ROS_INFO(...)  RCLCPP_INFO(::point_lio_compat::logger(), __VA_ARGS__)
+#endif
+#ifndef ROS_WARN
+#define ROS_WARN(...)  RCLCPP_WARN(::point_lio_compat::logger(), __VA_ARGS__)
+#endif
+#ifndef ROS_ERROR
+#define ROS_ERROR(...) RCLCPP_ERROR(::point_lio_compat::logger(), __VA_ARGS__)
+#endif
+#ifndef ROS_DEBUG
+#define ROS_DEBUG(...) RCLCPP_DEBUG(::point_lio_compat::logger(), __VA_ARGS__)
+#endif
+
+#endif  // POINT_LIO_ROS2_COMPAT_H
diff -ruN '--exclude=.git' '--exclude=Log' '--exclude=build' '--exclude=install' a/launch/mapping_mid360.launch.py b/launch/mapping_mid360.launch.py
--- a/launch/mapping_mid360.launch.py	1970-01-01 08:00:00.000000000 +0800
+++ b/launch/mapping_mid360.launch.py	2026-10-25 17:57:06.765606135 +0800
@@ -0,0 +1,52 @@
+"""Point-LIO 启动（ROS 2 Humble）。
+
+用法：
+    ros2 launch point_lio mapping_mid360.launch.py
+    ros2 launch point_lio mapping_mid360.launch.py rviz:=false
+    ros2 launch point_lio mapping_mid360.launch.py \
+        config_file:=$HOME/slam_benchmark/config/pointlio_mid360.yaml
+"""
+import os
+
+from ament_index_python.packages import get_package_share_directory
+from launch import LaunchDescription
+from launch.actions import DeclareLaunchArgument
+from launch.conditions import IfCondition
+from launch.substitutions import LaunchConfiguration
+from launch_ros.actions import Node
+
+
+def generate_launch_description():
+    share = get_package_share_directory('point_lio')
+
+    config_file = LaunchConfiguration('config_file')
+    use_rviz = LaunchConfiguration('rviz')
+    rviz_cfg = LaunchConfiguration('rviz_cfg')
+
+    return LaunchDescription([
+        DeclareLaunchArgument(
+            'config_file',
+            default_value=os.path.join(share, 'config', 'mid360.yaml'),
+            description='Point-LIO 参数文件（YAML）'),
+        DeclareLaunchArgument('rviz', default_value='true',
+                              description='是否启动 RViz'),
+        DeclareLaunchArgument(
+            'rviz_cfg',
+            default_value=os.path.join(share, 'rviz_cfg', 'loam_livox.rviz'),
+            description='RViz 配置'),
+
+        Node(
+            package='point_lio',
+            executable='pointlio_mapping',
+            name='laserMapping',
+            output='screen',
+            parameters=[config_file],
+        ),
+
+        Node(
+            package='rviz2', executable='rviz2', name='rviz2',
+            arguments=['-d', rviz_cfg],
+            condition=IfCondition(use_rviz),
+            output='log',
+        ),
+    ])
